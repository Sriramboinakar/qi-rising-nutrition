// Qi Rising Nutrition — Production Schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  COACH
  SUPER_ADMIN
}

enum ClientStatus {
  ACTIVE
  PAUSED
  COMPLETED
  INACTIVE
}

enum GoalCategory {
  MUSCLE_BUILDING
  FAT_LOSS
  BODY_RECOMPOSITION
  WEIGHT_MAINTENANCE
  PERFORMANCE
  LIFESTYLE_OPTIMIZATION
  LONGEVITY
  POSTPARTUM_SUPPORT
  SUSTAINABLE_HABITS
}

enum AssessmentType {
  INITIAL
  FOLLOW_UP
  REVIEW
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CheckInStatus {
  COMPLETED
  MISSED
  PENDING
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum PhotoType {
  FRONT
  SIDE
  BACK
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

// ---------------------------------------------------------------------------
// Users (Coach / Super Admin — clients have no accounts)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(COACH)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients     Client[]
  coachNotes  CoachNote[]
  followUps   FollowUp[]
  activities  Activity[]
}

// ---------------------------------------------------------------------------
// Programs (6-month / 12-month coaching programs)
// ---------------------------------------------------------------------------

model Program {
  id             String  @id @default(cuid())
  name           String
  slug           String  @unique
  description    String  @default("")
  durationMonths Int
  price          Decimal? @db.Decimal(10, 2)
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  clients Client[]
}

// ---------------------------------------------------------------------------
// Clients (managed internally by coach — no client accounts)
// ---------------------------------------------------------------------------

model Client {
  id              String       @id @default(cuid())
  firstName       String
  lastName        String
  email           String?      @unique
  phone           String?
  dateOfBirth     DateTime?
  sex             String? // "female" | "male" | "other"
  category        GoalCategory @default(FAT_LOSS)
  status          ClientStatus @default(ACTIVE)
  coachId         String
  programId       String?
  programStartDate DateTime?
  programEndDate  DateTime?
  heightCm        Decimal?     @db.Decimal(6, 2)
  emergencyContact String?
  notes           String?      @db.Text
  photoUrl        String?
  intakeSubmittedAt DateTime?
  intakeReviewedAt  DateTime?
  calorieTarget   Int?
  proteinTargetG  Int?
  carbsTargetG    Int?
  fatTargetG      Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  coach       User           @relation(fields: [coachId], references: [id])
  program     Program?       @relation(fields: [programId], references: [id])
  assessments Assessment[]
  plans       NutritionPlan[]
  checkIns    CheckIn[]
  progress    ProgressEntry[]
  photos      ProgressPhoto[]
  habits      Habit[]
  coachNotes  CoachNote[]
  followUps   FollowUp[]
  activities  Activity[]
  accessTokens ClientAccessToken[]

  @@index([coachId])
  @@index([status])
  @@index([programId])
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

model Assessment {
  id           String         @id @default(cuid())
  clientId     String
  type         AssessmentType @default(INITIAL)
  date         DateTime       @default(now())
  weightKg     Decimal?       @db.Decimal(6, 2)
  goalWeightKg Decimal?       @db.Decimal(6, 2)
  heightCm     Decimal?       @db.Decimal(6, 2)
  bodyFatPct   Decimal?       @db.Decimal(5, 2)
  chestCm      Decimal?       @db.Decimal(6, 2)
  waistCm      Decimal?       @db.Decimal(6, 2)
  hipsCm       Decimal?       @db.Decimal(6, 2)
  armCm        Decimal?       @db.Decimal(6, 2)
  thighCm      Decimal?       @db.Decimal(6, 2)
  activityLevel String?
  goalSummary  String?        @db.Text
  medicalNotes String?        @db.Text
  allergies    String?        @db.Text
  medications  String?        @db.Text
  lifestyleNotes String?      @db.Text
  dietaryPreference String?
  foodRestrictions String?
  mealTiming   String?
  sleepHours   Decimal?       @db.Decimal(4, 2)
  waterLiters  Decimal?       @db.Decimal(4, 2)
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Nutrition Plans
// ---------------------------------------------------------------------------

model NutritionPlan {
  id           String     @id @default(cuid())
  clientId     String
  name         String
  status       PlanStatus @default(DRAFT)
  calories     Int?
  proteinG     Int?
  carbsG       Int?
  fatG         Int?
  waterLiters  Decimal?   @db.Decimal(4, 2)
  startDate    DateTime?
  endDate      DateTime?
  supplements  String?    @db.Text
  notes        String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  meals  Meal[]

  @@index([clientId])
  @@index([status])
}

model Meal {
  id        String @id @default(cuid())
  planId    String
  mealOrder Int    @default(1)
  mealName  String // "Breakfast", "Lunch", ...
  timeOfDay String?
  foods     String @db.Text
  calories  Int?
  proteinG  Int?
  carbsG    Int?
  fatG      Int?
  notes     String? @db.Text

  plan NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// ---------------------------------------------------------------------------
// Weekly Check-ins
// ---------------------------------------------------------------------------

model CheckIn {
  id            String        @id @default(cuid())
  clientId      String
  weekNumber    Int
  checkInDate   DateTime      @default(now())
  status        CheckInStatus @default(COMPLETED)
  weightKg      Decimal?      @db.Decimal(6, 2)
  waistCm       Decimal?      @db.Decimal(6, 2)
  sleepHours    Decimal?      @db.Decimal(4, 2)
  energyLevel   Int? // 1-10
  mood          Int? // 1-10
  adherencePct  Int? // 0-100
  waterLiters   Decimal?      @db.Decimal(4, 2)
  notes         String?       @db.Text
  response      String?       @db.Text
  summary       String?       @db.Text
  followUpDate  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, weekNumber])
  @@index([clientId])
  @@index([status])
  @@index([checkInDate])
}

// ---------------------------------------------------------------------------
// Progress tracking (measurements + photos)
// ---------------------------------------------------------------------------

model ProgressEntry {
  id        String    @id @default(cuid())
  clientId  String
  date      DateTime  @default(now())
  weightKg  Decimal?  @db.Decimal(6, 2)
  chestCm   Decimal?  @db.Decimal(6, 2)
  waistCm   Decimal?  @db.Decimal(6, 2)
  hipsCm    Decimal?  @db.Decimal(6, 2)
  armCm     Decimal?  @db.Decimal(6, 2)
  thighCm   Decimal?  @db.Decimal(6, 2)
  bodyFatPct Decimal? @db.Decimal(5, 2)
  notes     String?   @db.Text

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

model ProgressPhoto {
  id       String    @id @default(cuid())
  clientId String
  date     DateTime  @default(now())
  url      String
  type     PhotoType @default(FRONT)
  note     String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Habit tracking
// ---------------------------------------------------------------------------

model Habit {
  id        String         @id @default(cuid())
  clientId  String
  name      String
  frequency HabitFrequency @default(DAILY)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  client Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  logs   HabitLog[]

  @@index([clientId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @default(now())
  completed Boolean  @default(true)
  note      String?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Coach notes
// ---------------------------------------------------------------------------

model CoachNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([clientId])
  @@index([pinned])
}

// ---------------------------------------------------------------------------
// Follow-ups
// ---------------------------------------------------------------------------

model FollowUp {
  id          String          @id @default(cuid())
  clientId    String
  authorId    String
  title       String
  description String?         @db.Text
  dueDate     DateTime
  priority    FollowUpPriority @default(MEDIUM)
  status      FollowUpStatus  @default(OPEN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  completedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([clientId])
  @@index([dueDate])
  @@index([status])
  @@index([priority])
}

// ---------------------------------------------------------------------------
// Activity log (drives the coach dashboard "what changed recently")
// ---------------------------------------------------------------------------

model Activity {
  id        String   @id @default(cuid())
  clientId  String?
  userId    String
  type      String // "client.created", "checkin.added", "followup.completed", ...
  message   String
  createdAt DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// System settings (key-value)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Client self-service access tokens (intake / check-in / plan links)
// ---------------------------------------------------------------------------

model ClientAccessToken {
  id          String    @id @default(cuid())
  clientId    String
  tokenHash   String    @unique
  purpose     String    @default("INTAKE") // "INTAKE" | "CHECKIN" | "PLAN"
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}